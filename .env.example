# Informational names only. Root .env is not loaded automatically.
# Public frontend setting goes in apps/web/.env.local (not currently used):
VITE_API_BASE_URL=
# Local worker secrets go in apps/api/.dev.vars (never commit):
DATABASE_URL=
DB_HEALTH_TOKEN=
# Non-secret comma-separated exact web origins go in Wrangler vars:
ALLOWED_ORIGINS=
